---
interface Props {
  num: string;
  title: string;
  id?: string;
  /** Optional one-line intro under the heading. */
  intro?: string;
  /** Heading level; sections on the home page use h2. */
  as?: 'h2' | 'h3';
  /** Set false when another script drives the animation (styleguide demo). */
  reveal?: boolean;
}
const { num, title, id, intro, as: Tag = 'h2', reveal = true } = Astro.props;
// Leading zero is set in grey so the significant digit carries the weight.
const lead = num.length > 1 && num.startsWith('0') ? '0' : '';
const rest = lead ? num.slice(1) : num;
---

<header class="section-head" data-section-head={reveal ? '' : undefined}>
  <div class="section-head__rules">
    <hr class="rule section-head__rule" data-rule />
    <span class="section-head__tick" data-tick></span>
  </div>
  <div class="section-head__row">
    <p class="section-head__num" aria-hidden="true">
      <span class="section-head__num-inner" data-num>{lead && <span class="section-head__zero">{lead}</span>}{rest}</span>
    </p>
    <div class="section-head__text">
      <Tag class="section-head__title" id={id} data-lines>{title}</Tag>
      {intro && <p class="section-head__intro" data-intro>{intro}</p>}
    </div>
  </div>
</header>

<script>
  import { gsap, lineReveal, DUR, EASE, prefersReducedMotion } from '../scripts/motion';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  let active: { triggers: ScrollTrigger[]; splits: ReturnType<typeof lineReveal>['split'][] }[] = [];

  function cleanup() {
    active.forEach(({ triggers, splits }) => {
      triggers.forEach((t) => t.kill());
      splits.forEach((s) => s.revert());
    });
    active = [];
  }

  // Same rhythm for every section: rule scales out, the big numeral and the heading slide up
  // behind their masks, the intro fades in. The numeral then drifts slightly with scroll.
  function initSectionHeads() {
    cleanup();
    if (prefersReducedMotion()) return;
    document.querySelectorAll<HTMLElement>('[data-section-head]').forEach((head) => {
      const rule = head.querySelector<HTMLElement>('[data-rule]');
      const tick = head.querySelector<HTMLElement>('[data-tick]');
      const num = head.querySelector<HTMLElement>('[data-num]');
      const title = head.querySelector<HTMLElement>('[data-lines]');
      const intro = head.querySelector<HTMLElement>('[data-intro]');
      if (!rule || !num || !title) return;

      const numReveal = lineReveal(num, { duration: DUR.slow, paused: true });
      const titleReveal = lineReveal(title, { duration: DUR.slow, delay: 0.1, paused: true });
      gsap.set([rule, tick], { scaleX: 0 });
      if (intro) gsap.set(intro, { autoAlpha: 0, y: 12 });

      const enter = ScrollTrigger.create({
        trigger: head,
        start: 'top 85%',
        once: true,
        onEnter: () => {
          gsap.to(rule, { scaleX: 1, duration: DUR.slow, ease: EASE.out });
          gsap.to(tick, { scaleX: 1, duration: DUR.base, ease: EASE.out });
          numReveal.play();
          titleReveal.play();
          if (intro) gsap.to(intro, { autoAlpha: 1, y: 0, duration: DUR.base, delay: 0.2, ease: EASE.out });
        },
      });

      // Parallax on the numeral's outer box (the inner lines are driven by the reveal).
      const drift = ScrollTrigger.create({
        trigger: head,
        start: 'top bottom',
        end: 'bottom top',
        scrub: true,
        animation: gsap.fromTo(head.querySelector('.section-head__num'), { yPercent: 12 }, { yPercent: -12, ease: 'none' }),
      });

      active.push({ triggers: [enter, drift], splits: [numReveal.split, titleReveal.split] });
    });
  }

  document.addEventListener('astro:page-load', () => {
    document.fonts.ready.then(initSectionHeads);
  });
  document.addEventListener('astro:before-swap', cleanup);
</script>

<style>
  .section-head {
    margin-bottom: var(--space-7);
  }

  .section-head__rules {
    position: relative;
    margin-bottom: var(--space-3);
  }

  /* Short accent lead-in on the section rule. */
  .section-head__tick {
    position: absolute;
    left: 0;
    top: -0.5px;
    width: var(--space-6);
    height: 2px;
    background: var(--accent);
    transform-origin: left center;
  }

  .section-head__zero {
    color: var(--muted);
  }

  .section-head__row {
    display: grid;
    grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: var(--space-3);
    align-items: end;
  }

  /* Chapter numeral: the largest type after the hero name. */
  .section-head__num {
    grid-column: 1 / -1;
    font-family: var(--font-display);
    font-size: clamp(6rem, 3rem + 16vw, 17rem);
    font-weight: 500;
    line-height: 0.8;
    letter-spacing: -0.06em;
    font-variant-numeric: tabular-nums;
    margin-left: -0.04em;
  }

  .section-head__num-inner {
    display: block;
  }

  .section-head__text {
    grid-column: 1 / -1;
    display: grid;
    gap: var(--space-2);
  }

  .section-head__title {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 500;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
  }

  .section-head__intro {
    max-width: 44ch;
    color: var(--muted);
  }

  @media (min-width: 48rem) {
    .section-head__num {
      grid-column: 1 / span 5;
    }
    .section-head__text {
      grid-column: 6 / -1;
      padding-bottom: 0.4em;
    }
  }
</style>
