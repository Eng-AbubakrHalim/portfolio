---
interface Props {
  num: string;
  title: string;
  id?: string;
  /** Heading level; sections on the home page use h2. */
  as?: 'h2' | 'h3';
}
const { num, title, id, as: Tag = 'h2' } = Astro.props;
---

<header class="section-head" data-section-head>
  <hr class="rule section-head__rule" data-rule />
  <div class="section-head__row">
    <span class="section-head__num label" aria-hidden="true">{num}</span>
    <Tag class="section-head__title" id={id} data-lines>{title}</Tag>
  </div>
</header>

<style>
  .section-head {
    margin-bottom: var(--space-6);
  }

  .section-head__rule {
    margin-bottom: var(--space-3);
  }

  .section-head__row {
    display: grid;
    grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: var(--space-2);
    align-items: baseline;
  }

  .section-head__num {
    grid-column: 1 / -1;
    color: var(--muted);
  }

  .section-head__title {
    grid-column: 1 / -1;
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 500;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
  }

  @media (min-width: 48rem) {
    .section-head__num {
      grid-column: 1 / span 3;
    }
    .section-head__title {
      grid-column: 4 / -1;
    }
  }
</style>
