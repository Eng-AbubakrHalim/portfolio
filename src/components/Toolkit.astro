---
import { toolkit } from '../data/toolkit';
---

<div class="kit" data-kit>
  <div class="kit__head" aria-hidden="true">
    <span>Ref</span>
    <span>Domain</span>
    <span>Tools and methods</span>
    <span>Applied in</span>
  </div>
  <ol class="kit__rows" role="list">
    {
      toolkit.map((row, i) => (
        <li class="kit__row" data-reveal>
          <span class="kit__ref" aria-hidden="true">
            04.{i + 1}
          </span>
          <h3 class="kit__domain">{row.domain}</h3>
          <p class="kit__tools">
            {row.tools.map((t, j) => (
              <>
                <span class="kit__tool">{t}</span>
                {j < row.tools.length - 1 && <span class="kit__sep" aria-hidden="true">/</span>}{' '}
              </>
            ))}
          </p>
          <p class="kit__used">
            <span class="visually-hidden">Applied in: </span>
            {row.usedIn.join(', ')}
          </p>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .kit__head {
    display: none;
  }

  .kit__row {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: var(--space-1) var(--gutter);
    padding-block: var(--space-4);
    border-bottom: var(--hairline) solid var(--rule);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .kit__rows {
    border-top: var(--hairline) solid var(--rule);
  }

  .kit__ref {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    color: var(--accent);
    padding-top: 0.35em;
  }

  .kit__domain {
    font-weight: 400;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    padding-top: 0.35em;
  }

  .kit__tools {
    grid-column: 2;
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: var(--tracking-tight);
  }

  .kit__sep {
    color: var(--rule);
    margin-inline: 0.35em;
    font-weight: 400;
  }

  .kit__used {
    grid-column: 2;
    font-size: var(--text-small);
    color: var(--muted);
  }

  /* Hovering a domain sets the others back, like the work list. */
  .kit__rows:has(.kit__row:hover) .kit__row:not(:hover) {
    color: var(--muted);
  }

  @media (min-width: 64rem) {
    .kit__head {
      display: grid;
      grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
      column-gap: var(--gutter);
      padding-bottom: var(--space-2);
      font-family: var(--font-mono);
      font-size: var(--text-label);
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
      color: var(--muted);
    }
    .kit__head span:nth-child(1) {
      grid-column: 1;
    }
    .kit__head span:nth-child(2) {
      grid-column: 2 / span 2;
    }
    .kit__head span:nth-child(3) {
      grid-column: 4 / span 6;
    }
    .kit__head span:nth-child(4) {
      grid-column: 10 / -1;
    }
    .kit__row {
      grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
      align-items: baseline;
    }
    .kit__ref {
      grid-column: 1;
    }
    .kit__domain {
      grid-column: 2 / span 2;
    }
    .kit__tools {
      grid-column: 4 / span 6;
    }
    .kit__used {
      grid-column: 10 / -1;
    }
  }
</style>
