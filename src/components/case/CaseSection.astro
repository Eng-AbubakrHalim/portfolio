---
import SectionHeader from '../SectionHeader.astro';

interface Props {
  num: string;
  title: string;
}
const { num, title } = Astro.props;
const id = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---

<section class="case-section" aria-labelledby={`${id}-title`}>
  <SectionHeader num={num} title={title} id={`${id}-title`} size="compact" />
  <div class="case-section__body">
    <slot />
  </div>
</section>

<style>
  .case-section {
    padding-top: var(--space-8);
  }

  .case-section__body {
    display: grid;
    max-width: var(--measure);
  }

  .case-section__body > :global(p) {
    margin-block: 0 var(--space-2);
  }

  .case-section__body :global(.diagram),
  .case-section__body :global(.fig--wide),
  .case-section__body :global(.decisions) {
    max-width: none;
    width: min(100vw - 2 * var(--page-margin), 75rem);
  }

  .case-section__body :global(ul:not([role='list'])) {
    display: grid;
    gap: var(--space-1);
    padding-left: var(--space-3);
    margin-block: 0 var(--space-2);
  }
</style>
