---
import SectionHeader from '../SectionHeader.astro';

interface Props {
  num: string;
  title: string;
}
const { num, title } = Astro.props;
const id = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---

<section class="case-section" aria-labelledby={`${id}-title`}>
  <SectionHeader num={num} title={title} id={`${id}-title`} size="compact" />
  <div class="case-section__body">
    <slot />
  </div>
</section>

<style>
  .case-section {
    padding-top: var(--space-8);
  }

  /* Block flow: running text keeps to the reading measure, diagrams and wide figures use the full width. */
  .case-section__body > :global(p),
  .case-section__body > :global(ul),
  .case-section__body > :global(.fig:not(.fig--wide)) {
    max-width: var(--measure);
  }

  .case-section__body > :global(p) {
    margin-block: 0 var(--space-2);
  }

  .case-section__body :global(ul:not([role='list'])) {
    display: grid;
    gap: var(--space-1);
    padding-left: var(--space-3);
    margin-block: 0 var(--space-2);
  }
</style>
