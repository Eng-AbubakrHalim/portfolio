---
interface Props {
  position: string;
  meta: string[];
}
const { position, meta } = Astro.props;
---

<section class="hero page" id="top" aria-labelledby="hero-name" data-hero>
  <div class="hero__fit">
    <h1 class="hero__name" id="hero-name">
      <span class="hero__line" data-hero-line>Abubakr M.</span>{' '}
      <span class="hero__line" data-hero-line>Abdelhalim</span>
    </h1>
  </div>
  <div class="hero__below" data-hero-below>
    <p class="hero__position" data-hero-fade>{position}</p>
    <p class="hero__meta label" data-hero-fade>
      {
        meta.map((m, i) => (
          <>
            {i > 0 && <span aria-hidden="true">·</span>}
            <span>{m}</span>
          </>
        ))
      }
      <span aria-hidden="true">·</span>
      <span class="hero__clock">
        <span class="visually-hidden">Local time in Malaysia:</span>
        <time data-clock-time>--:--</time> MYT
      </span>
    </p>
    <a class="hero__cta" href="#work" data-hero-fade>View work</a>
  </div>
</section>

<script>
  import { gsap, lineReveal, DUR, EASE, prefersReducedMotion } from '../scripts/motion';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  let reveals: ReturnType<typeof lineReveal>[] = [];
  let exit: ScrollTrigger | undefined;
  let clockTimer: number | undefined;

  const clockFormat = new Intl.DateTimeFormat('en-GB', {
    timeZone: 'Asia/Kuala_Lumpur',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
  });

  function startClock() {
    const el = document.querySelector<HTMLTimeElement>('[data-clock-time]');
    if (!el) return;
    const tick = () => (el.textContent = clockFormat.format(new Date()));
    tick();
    window.clearInterval(clockTimer);
    clockTimer = window.setInterval(tick, 15_000);
  }

  function cleanup() {
    reveals.forEach((r) => r.split.revert());
    reveals = [];
    exit?.kill();
    exit = undefined;
  }

  document.addEventListener('astro:page-load', () => {
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    if (!hero) return;
    startClock();
    const root = document.documentElement;

    if (prefersReducedMotion()) {
      root.classList.add('hero-ready');
      return;
    }

    const lines = [...hero.querySelectorAll<HTMLElement>('[data-hero-line]')];
    const fades = hero.querySelectorAll<HTMLElement>('[data-hero-fade]');

    // Split once fonts are in so the masked lines match the final layout; don't wait forever.
    const fontsReady = Promise.race([document.fonts.ready, new Promise((r) => setTimeout(r, 1500))]);
    fontsReady.then(() => {
      cleanup();
      // One reveal per line (60ms apart) so the outer line spans stay stable for the scroll exit below.
      reveals = lines.map((line, i) => lineReveal(line, { duration: DUR.slow, delay: i * 0.06 }));
      gsap.from(fades, {
        autoAlpha: 0,
        y: 12,
        duration: DUR.base,
        delay: 0.3,
        stagger: 0.05,
        ease: EASE.out,
        clearProps: 'transform,opacity,visibility',
      });
      root.classList.add('hero-ready');

      // Scrolling out of the hero pulls the two lines of the name apart (scrubbed, so linear).
      exit = ScrollTrigger.create({
        trigger: hero,
        start: 'top top',
        end: 'bottom top',
        scrub: true,
        animation: gsap
          .timeline()
          .to(lines[0], { xPercent: -14, ease: 'none' }, 0)
          .to(lines[1], { xPercent: 14, ease: 'none' }, 0)
          .to(hero.querySelector('[data-hero-below]'), { autoAlpha: 0, y: -24, ease: 'none' }, 0),
      });
    });
  });

  document.addEventListener('astro:before-swap', () => {
    cleanup();
    window.clearInterval(clockTimer);
  });
</script>

<style>
  .hero {
    min-height: 100svh;
    display: grid;
    align-content: end;
    padding-top: calc(var(--header-h) + var(--space-5));
    padding-bottom: var(--space-5);
    overflow: clip;
  }

  /* Phones: a shorter hero so the facts strip shows at the bottom of the first screen. */
  @media (max-width: 47.99rem) {
    .hero {
      min-height: 80svh;
    }
  }

  /* The name is sized from this box's width: font-size = width / measured em-width of the longest line. */
  .hero__fit {
    container-type: inline-size;
  }

  /* Width-fit, but on short wide screens cap by height so the line below stays above the fold
     (19rem ≈ header + paddings + the row below; 1.84 = two lines at 0.92 leading). */
  .hero__name {
    font-family: var(--font-display);
    font-size: min(calc(100cqi / var(--hero-fit)), calc((100svh - 19rem) / 1.84));
    font-weight: 500;
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    white-space: nowrap;
  }

  .hero__line {
    display: block;
  }

  .hero__below {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-5);
    padding-top: var(--space-3);
    border-top: var(--hairline) solid var(--rule);
  }

  .hero__position {
    font-size: var(--text-lead);
    line-height: 1.35;
    max-width: 28ch;
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-half) var(--space-1);
  }

  .hero__clock time {
    color: var(--fg);
    font-variant-numeric: tabular-nums;
  }

  .hero__cta {
    justify-self: start;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--fg);
    padding-block: var(--space-1);
    text-underline-offset: 0.35em;
  }

  .hero__cta:hover {
    color: var(--accent);
  }

  @media (min-width: 64rem) {
    .hero__below {
      grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
      column-gap: var(--gutter);
      align-items: baseline;
    }
    .hero__position {
      grid-column: 1 / span 4;
    }
    .hero__meta {
      grid-column: 5 / span 6;
    }
    .hero__cta {
      grid-column: 11 / -1;
      justify-self: end;
    }
  }

  /* Hold the hero hidden until the reveal starts (html.js is set before paint; a timeout clears it). */
  :global(html.js:not(.hero-ready)) .hero__name,
  :global(html.js:not(.hero-ready)) [data-hero-fade] {
    visibility: hidden;
  }
</style>
