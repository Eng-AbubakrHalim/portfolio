---
/**
 * Kinetic band: a large single line that drifts sideways, speeds up with scroll velocity
 * and follows the scroll direction. Static under reduced motion.
 */
interface Props {
  items: string[];
  label: string;
}
const { items, label } = Astro.props;
---

<div class="band" data-band>
  <p class="visually-hidden">{label}: {items.join(', ')}.</p>
  <div class="band__track" aria-hidden="true" data-band-track>
    {
      [0, 1].map(() => (
        <div class="band__group">
          {items.map((item) => (
            <>
              <span class="band__item">{item}</span>
              <span class="band__mark" />
            </>
          ))}
        </div>
      ))
    }
  </div>
</div>

<script>
  import { gsap, prefersReducedMotion } from '../scripts/motion';
  import { lenis } from '../scripts/smooth';

  let stop: (() => void) | undefined;

  document.addEventListener('astro:page-load', () => {
    stop?.();
    const band = document.querySelector<HTMLElement>('[data-band]');
    const track = band?.querySelector<HTMLElement>('[data-band-track]');
    if (!band || !track || prefersReducedMotion()) return;

    const setX = gsap.quickSetter(track, 'x', 'px');
    const IDLE = 40; // px/s drift when the page is still
    const MAX = 200; // px/s cap while scrolling, so fast scrolls never spin it
    const GAIN = 4; // px/s added per px/frame of scroll velocity
    const EASE_MS = 250; // time constant for speed and direction changes
    let groupWidth = track.scrollWidth / 2;
    let x = 0;
    let speed = -IDLE; // signed px/s, negative = leftward
    let dir = -1;
    let visible = false;

    // Two identical groups: wrapping by one group width makes the loop seamless.
    const tick = (_time: number, deltaMs: number) => {
      if (!visible || !groupWidth) return;
      const velocity = lenis?.velocity ?? 0;
      if (velocity > 0.5) dir = -1;
      else if (velocity < -0.5) dir = 1;
      const target = dir * Math.min(IDLE + Math.abs(velocity) * GAIN, MAX);
      speed += (target - speed) * (1 - Math.exp(-deltaMs / EASE_MS));
      x += (speed * deltaMs) / 1000;
      if (x <= -groupWidth) x += groupWidth;
      if (x > 0) x -= groupWidth;
      setX(x);
    };

    const ro = new ResizeObserver(() => (groupWidth = track.scrollWidth / 2));
    ro.observe(track);
    const io = new IntersectionObserver(([entry]) => (visible = entry.isIntersecting));
    io.observe(band);
    gsap.ticker.add(tick);

    stop = () => {
      gsap.ticker.remove(tick);
      io.disconnect();
      ro.disconnect();
    };
  });

  document.addEventListener('astro:before-swap', () => stop?.());
</script>

<style>
  .band {
    overflow: clip;
    padding-block: var(--space-6);
    border-block: var(--hairline) solid var(--rule);
    margin-top: var(--section-pad);
  }

  .band__track {
    display: flex;
    width: max-content;
  }

  .band__group {
    display: flex;
    align-items: center;
    flex: none;
  }

  .band__item {
    font-family: var(--font-display);
    font-size: clamp(3rem, 1rem + 7vw, 8.5rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: var(--tracking-display);
    white-space: nowrap;
  }

  /* Small accent square between items: the only colour in the band. */
  .band__mark {
    width: 0.16em;
    height: 0.16em;
    margin-inline: 0.45em;
    font-size: clamp(3rem, 1rem + 7vw, 8.5rem);
    background: var(--accent);
    flex: none;
  }

  /* Reduced motion: no drift, so show the first items in a single static line. */
  @media (prefers-reduced-motion: reduce) {
    .band__track {
      transform: none !important;
    }
  }
</style>
