---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Font CSS variables to load on this page. */
  fonts?: string[];
  noindex?: boolean;
}

const {
  title,
  description = 'Abubakr M. Abdelhalim — electrical engineer working on hardware design, embedded systems and power quality.',
  fonts = ['--font-familjen', '--font-plex-mono'],
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0e0e0c" />
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} type="image/svg+xml" />
    {fonts.map((cssVariable, i) => <Font cssVariable={cssVariable} preload={i === 0} />)}
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const apply = () => {
          root.classList.add('js');
          try {
            const t = localStorage.getItem('theme');
            if (t === 'light' || t === 'dark') root.dataset.theme = t;
          } catch {}
          const meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', root.dataset.theme === 'light' ? '#f2f0ea' : '#0e0e0c');
        };
        apply();
        // The router copies <html> attributes from the next page; re-apply theme and the js flag.
        document.addEventListener('astro:after-swap', apply);
        // Never leave the hero hidden if its script fails to run.
        setTimeout(() => root.classList.add('hero-ready'), 2500);
      })();
    </script>
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
