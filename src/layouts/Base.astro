---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import { profile } from '../data/profile';
import { withBase } from '../lib/url';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Font CSS variables to load on this page. */
  fonts?: string[];
  noindex?: boolean;
  /** Social preview image, relative to the site base (generated by scripts/build-og.mjs). */
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
}

const {
  title,
  description = 'Abubakr M. Abdelhalim, electrical engineer: hardware design, embedded systems, power and signal integrity.',
  fonts = ['--font-familjen', '--font-plex-mono'],
  noindex = false,
  ogImage = 'og/home.png',
  ogImageAlt = `${profile.name}, electrical engineer`,
  ogType = 'website',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(withBase(ogImage), Astro.site);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0e0e0c" />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')} />
    <link rel="sitemap" href={withBase('sitemap-index.xml')} />

    <meta property="og:site_name" content={profile.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {fonts.map((cssVariable, i) => <Font cssVariable={cssVariable} preload={i === 0} />)}
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const apply = () => {
          root.classList.add('js');
          try {
            const t = localStorage.getItem('theme');
            if (t === 'light' || t === 'dark') root.dataset.theme = t;
          } catch {}
          const meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', root.dataset.theme === 'light' ? '#f2f0ea' : '#0e0e0c');
        };
        apply();
        // The router copies <html> attributes from the next page; re-apply theme and the js flag.
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
